# Local dev configuration for both web apps. Copy to .env and fill in.
# Vite reads it via envDir, Next.js via loadEnvConfig in next.config.ts.

# --- platform (server-side only) ---

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# CloudFormation output: WebClientId (rescufood-<env>-iam stack)
AUTH_COGNITO_ID=

# App client secret (Cognito console -> App clients, or:
# aws cognito-idp describe-user-pool-client)
AUTH_COGNITO_SECRET=

# CloudFormation output: Issuer
# e.g. https://cognito-idp.ap-southeast-1.amazonaws.com/<user-pool-id>
AUTH_COGNITO_ISSUER=

# base url of the profile service
PROFILE_API_URL=http://localhost:3001

# base url of the listings service
LISTINGS_API_URL=http://localhost:3002

# --- admin console (VITE_ vars are inlined into the browser bundle) ---

VITE_AWS_REGION=ap-southeast-1

# CloudFormation output: AdminConsoleClientId (rescufood-<env>-iam stack)
VITE_COGNITO_CLIENT_ID=

# base url of the profile service
VITE_PROFILE_API_URL=http://localhost:3001
# swap the two lines above and below to administer a deployed environment
# VITE_PROFILE_API_URL=http://rescufood-dev-alb-1968524694.ap-southeast-1.elb.amazonaws.com
