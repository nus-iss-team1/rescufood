# Auth.js + AWS Cognito (rescufood-<env>-iam CloudFormation stack)
# Copy to .env.local and fill in after deploying the IAM stack.

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# CloudFormation output: WebClientId
AUTH_COGNITO_ID=

# App client secret (Cognito console -> App clients, or:
# aws cognito-idp describe-user-pool-client)
AUTH_COGNITO_SECRET=

# CloudFormation output: Issuer
# e.g. https://cognito-idp.ap-southeast-1.amazonaws.com/<user-pool-id>
AUTH_COGNITO_ISSUER=

# base url of the profile service (server-side calls only)
PROFILE_API_URL=http://localhost:3001
