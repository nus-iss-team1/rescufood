PORT=3001

# development = colorized text logs; anything else = JSON
ENV=development

# local: compose.yaml's postgres. deployed: composed from the RDS secret.
DATABASE_URL=postgres://profile:profile@localhost:5432/profile?sslmode=disable

# CloudFormation output: Issuer (rescufood-<env>-iam stack)
AUTH_COGNITO_ISSUER=

# comma-separated browser origins allowed to call the api
CORS_ALLOWED_ORIGINS=http://localhost:5173
