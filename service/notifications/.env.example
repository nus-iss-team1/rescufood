PORT=3003

# dev = colorized text logs; anything else = JSON
ENV=dev

# Own database, unlike listings which shares profile's - a notification
# row never needs to join against listings/profile tables, so there's no
# reason to couple this service's schema to theirs. local: this service's
# own compose.yaml. deployed: composed from its own RDS secret.
DATABASE_URL=postgres://notifications:notifications@localhost:5433/notifications?sslmode=disable

# CloudFormation output: QueueUrl (rescufood-<env>-messaging stack)
NOTIFICATION_QUEUE_URL=

# Credentials for the SQS client come from the default AWS SDK chain
# (ECS task role when deployed; a local AWS profile/env vars for dev).
AWS_REGION=ap-southeast-1

# Gmail account emails are sent through - an address you own and control,
# unlike SES sending "from" a domain it isn't authorized for (fails
# SPF/DKIM/DMARC at the recipient). Generate the app password at
# https://myaccount.google.com/apppasswords (needs 2FA enabled).
GMAIL_USER=
GMAIL_APP_PASSWORD=
