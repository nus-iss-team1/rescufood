PORT=3002

# dev = colorized text logs; anything else = JSON
ENV=dev

# Shared database with service/profile - listings/requests/notifications/audit_log
# reference organisations/users via plain FK columns (see src/db/external.schema.ts).
# local: service/profile/compose.yaml's postgres. deployed: composed from the RDS secret.
DATABASE_URL=postgres://profile:profile@localhost:5432/profile?sslmode=disable

# CloudFormation output: Issuer (rescufood-<env>-iam stack)
AUTH_COGNITO_ISSUER=

# comma-separated browser origins allowed to call the api
CORS_ALLOWED_ORIGINS=http://localhost:5173

# app-wide rate limit (see ThrottlerModule in src/app.module.ts) - defaults
# to 100 requests per 60s per client if unset
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# S3 bucket listing images are uploaded to (see src/storage/s3.service.ts).
# Credentials come from the default AWS SDK chain (ECS task role when
# deployed; a local AWS profile/env vars for dev).
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=

# CloudFront domain images are served from (CloudFormation output:
# ListingImagesCDNUrl, rescufood-<env>-data stack). Bucket is private -
# reads only work through this CDN, not direct S3 URLs.
LISTING_IMAGES_CDN_URL=
