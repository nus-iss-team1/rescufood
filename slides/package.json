{
  "name": "slides",
  "type": "module",
  "private": true,
  "scripts": {
    "fix-svg": "node scripts/fix-svg.mjs",
    "predev": "node scripts/fix-svg.mjs",
    "prebuild": "node scripts/fix-svg.mjs",
    "build": "slidev build",
    "dev": "slidev --open",
    "export": "slidev export",
    "preexport:pptx": "node scripts/fix-svg.mjs",
    "export:pptx": "slidev export --format pptx --with-clicks --output deliverables/rescufood.pptx",
    "dev:diagrams": "slidev diagrams.md --open",
    "build:diagrams": "slidev build diagrams.md --out dist/diagrams",
    "export:diagrams": "slidev export diagrams.md --format png --output deliverables/diagrams",
    "build:sequences": "node scripts/sequences/render.mjs"
  },
  "dependencies": {
    "@slidev/cli": "^52.19.1",
    "@slidev/theme-default": "latest",
    "@slidev/theme-seriph": "latest",
    "vue": "^3.5.33"
  },
  "devDependencies": {
    "playwright-chromium": "^1.64.1"
  }
}
